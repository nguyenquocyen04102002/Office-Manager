# Sao chép file này thành ".env" rồi chỉnh sửa:  copy .env.example .env   (Windows CMD)

# ---- Cổng publish ra máy host (đã chọn khác các dự án trước) ----
FRONTEND_PORT=18080
BACKEND_PORT=18000
DB_PORT=15432

# ---- PostgreSQL ----
POSTGRES_DB=office_db
POSTGRES_USER=office_user
POSTGRES_PASSWORD=office_password

# ---- Backend ----
# Tạo khóa ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-khoa-bi-mat-nay-trong-file-env
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:18080
TIMEZONE=Asia/Ho_Chi_Minh

# Giờ làm việc (dùng để tính đi muộn / về sớm)
WORK_START=08:30
WORK_END=17:30

# ---- Dữ liệu mẫu ----
# true: tự tạo dữ liệu demo nếu database còn trống
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@congty.vn
SEED_ADMIN_PASSWORD=Admin@123
